            <component
              refId="Package\LoadDimCustomer\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    'AW' + RIGHT('00000000' + CAST(C.CustomerID AS varchar(8)), 8)
        AS CustomerAlternateKey,

    CAST(NULL AS int) AS GeographyKey,

    P.Title,
    P.FirstName,
    P.MiddleName,
    P.LastName,
    P.NameStyle,
    P.Suffix,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:BirthDate)[1]',
        'date'
    ) AS BirthDate,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:MaritalStatus)[1]',
        'nvarchar(10)'
    ) AS MaritalStatus,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:Gender)[1]',
        'nvarchar(10)'
    ) AS Gender,

    CAST(NULL AS money) AS YearlyIncome,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:TotalChildren)[1]',
        'tinyint'
    ) AS TotalChildren,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:NumberChildrenAtHome)[1]',
        'tinyint'
    ) AS NumberChildrenAtHome,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:Education)[1]',
        'nvarchar(50)'
    ) AS EnglishEducation,

    CAST(NULL AS nvarchar(50)) AS SpanishEducation,
    CAST(NULL AS nvarchar(50)) AS FrenchEducation,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:Occupation)[1]',
        'nvarchar(50)'
    ) AS EnglishOccupation,

    CAST(NULL AS nvarchar(50)) AS SpanishOccupation,
    CAST(NULL AS nvarchar(50)) AS FrenchOccupation,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:HomeOwnerFlag)[1]',
        'nchar(1)'
    ) AS HouseOwnerFlag,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:NumberCarsOwned)[1]',
        'tinyint'
    ) AS NumberCarsOwned,

    A.AddressLine1,
    A.AddressLine2,

    E.EmailAddress,

    PP.PhoneNumber AS Phone,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:DateFirstPurchase)[1]',
        'date'
    ) AS DateFirstPurchase,

    P.Demographics.value(
        'declare namespace ns="http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/IndividualSurvey";
         (/ns:IndividualSurvey/ns:CommuteDistance)[1]',
        'nvarchar(50)'
    ) AS CommuteDistance

FROM AdventureWorks2025.Sales.Customer AS C

LEFT JOIN AdventureWorks2025.Person.Person AS P
    ON C.PersonID = P.BusinessEntityID

LEFT JOIN AdventureWorks2025.Person.BusinessEntityAddress AS BEA
    ON BEA.BusinessEntityID =
       CASE
           WHEN C.PersonID IS NOT NULL THEN C.PersonID
           ELSE C.StoreID
       END
   AND BEA.AddressTypeID =
       CASE
           WHEN C.PersonID IS NOT NULL THEN 2
           ELSE 3
       END

LEFT JOIN AdventureWorks2025.Person.Address AS A
    ON A.AddressID = BEA.AddressID

LEFT JOIN AdventureWorks2025.Person.EmailAddress AS E
    ON E.BusinessEntityID = C.PersonID

LEFT JOIN AdventureWorks2025.Person.PersonPhone AS PP
    ON PP.BusinessEntityID = C.PersonID;</property>
