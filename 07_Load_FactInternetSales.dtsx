            <component
              refId="Package\Load_FactInternetSales\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    H.SalesOrderID,
    H.SalesOrderNumber,
    H.RevisionNumber,
    H.OrderDate,
    H.DueDate,
    H.ShipDate,

    H.CustomerID,

    CAST(
        'AW' + RIGHT(
            '00000000' + CAST(H.CustomerID AS VARCHAR(8)),
            8
        )
        AS VARCHAR(15)
    ) AS CustomerAlternateKey,

    H.TerritoryID,
    H.CurrencyRateID,
    CR.ToCurrencyCode,

    H.TaxAmt,
    H.Freight,
    H.PurchaseOrderNumber,

    D.SalesOrderDetailID,

    ROW_NUMBER() OVER (
        PARTITION BY H.SalesOrderID
        ORDER BY D.SalesOrderDetailID
    ) AS SalesOrderLineNumber,

    D.ProductID,
    P.ProductNumber,

    D.SpecialOfferID,
    D.OrderQty,
    D.UnitPrice,
    D.UnitPriceDiscount,
    D.LineTotal,
    D.CarrierTrackingNumber

FROM AdventureWorks2025.Sales.SalesOrderHeader AS H
INNER JOIN AdventureWorks2025.Sales.SalesOrderDetail AS D
    ON H.SalesOrderID = D.SalesOrderID
INNER JOIN AdventureWorks2025.Production.Product AS P
    ON D.ProductID = P.ProductID
LEFT JOIN AdventureWorks2025.Sales.CurrencyRate AS CR
    ON H.CurrencyRateID = CR.CurrencyRateID
WHERE H.OnlineOrderFlag = 1;</property>
